---
import "../styles/global.css";
import Navmenu from "./Navmenu.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- updated on {new Date().toISOString().split('T')[0]} -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Launch Point Zero - Directory of sites to launch and promote Statrtups, Software as a Sevice, and Apps. We track and rate each site to launch from, as well as provide reviews for each one."
    />
    <meta
      property="og:title"
      content="Launch Point Zero - Directory of sites to launch and promote Statrtup, Software as a Sevice, and Apps"
    />
    <meta
      property="og:description"
      content="A Directory of places to launch and promote an  Statrtup, Software as a Sevice (SaaS), and Apps, with reviews for each"
    />
    <meta
      name="ahrefs-site-verification"
      content="1d74cf088db6769cfc9ef54d7001dfe36c006f6691014c442b43b6eb7dc7d2f5"
    />
    <meta name="google-adsense-account" content="ca-pub-6930952556082470" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD"
      crossorigin="anonymous"
    />
    <title>
      Launch Point Zero - Directory of sites to launch and promote Statrtups,
      Software as a Sevice, and Apps
    </title>
  </head>
  <body>
    <Navmenu />
    <slot />
    <footer class="text-center p-3 bg-dark text-white">
      ©️ <span itemprop="”name”">Launch Point Zero</span> 2026
    </footer>
  </body>
</html>
